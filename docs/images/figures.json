{
  "data": {
    "unit_source": {"from":"regex","path":"examples/config-version/spine_unit.rs","pattern":"(?s)format!\\(\\n(.*?)\",\\n    \\)"},
    "package_identity": {"from":"regex","path":"examples/config-version/spine_unit.rs","pattern":"PACKAGE_IDENTITY: &str = \"([^\"]+)\";"},
    "unit_body": {"from":"expr","value":"replace(replace(replace(replace(replace(unit_source, '\\\\\\n', ''), '\\\\\"', '\"'), '{{', '{'), '}}', '}'), '{PACKAGE_IDENTITY:?}', '\"' + package_identity + '\"')"},
    "unit_statements": {"from":"expr","value":"drop(rsub(squash(split(unit_body, '\\\\n')), '^\"+', ''), '^$|^//|^function')"},
    "unit_lines": {"from":"expr","value":"split(join(rsub(unit_statements, '^\\s*([^{]*?)\\s*\\{\\s*(.*?)\\s*\\}$', '$1 {\\n  $2\\n}'), '\\n'), '\\n')"},
    "capability_table": {"from":"regex","path":"fsl-semantics/src/library/bundle.rs","pattern":"(?s)const COMPLETE_CAPABILITY_FAMILIES(.*?)\\];"},
    "capability_codes": {"from":"expr","value":"findall(capability_table, '\\(\"([A-Z]+)\",\\s*\\d+\\)')"},
    "capability_counts": {"from":"expr","value":"findall(capability_table, '\\(\"[A-Z]+\",\\s*(\\d+)\\)')"},
    "capability_total": {"from":"expr","value":"sum(capability_counts)"}
  },
  "figures": [

language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
function equal0 using v(a: UUID,b: UUID): Boolean pure { a=b }
function equal1 using v(a: Timestamp,b: Timestamp): Boolean pure { a=b }
function equal2 using v(a: Bytes,b: Bytes): Boolean pure { a=b }
function equal3 using v(a: JsonObject,b: JsonObject): Boolean pure { a=b }

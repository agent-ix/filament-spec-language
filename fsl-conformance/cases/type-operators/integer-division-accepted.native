language "ix:native" edition "1-draft";
profile v = "filament.value.complete/v1";
profile law = "filament.value.integer-division.euclidean/v1";
function quotient using v(a: Int[-7,7],b: Int[1,3]): Int[-7,7] pure { a div b }
function remainder using v(a: Int[-7,7],b: Int[1,3]): Int[-7,7] pure { a rem b }

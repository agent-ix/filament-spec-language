language "ix:native" edition "1-draft";
profile t = "filament.temporal.complete/v1";
model M = "test/counter-step";
dimension Time;
unit ms : Time = rational(1, 1);
taskset Ctl {
task a periodic 4 ms deadline 4 ms wcet 1 ms priority 1 lo;
task b periodic 6 ms deadline 6 ms wcet 2 ms priority 2 lo;
task c periodic 12 ms deadline 12 ms wcet 5 ms priority 3 lo;
}
schedulable CtlFp on Ctl under fixed_priority;

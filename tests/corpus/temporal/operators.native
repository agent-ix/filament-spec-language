language "ix:native" edition "1-draft";
profile t = "filament.temporal.infinite-trace/v1";
record Reading { ready: Boolean; }
temporal BoundedUntil using t over (r: Reading) clock "steps" on origin {
  (not holds(r.ready)) until[0,2] holds(r.ready)
}
temporal Nested using t over (r: Reading) clock "steps" on origin {
  always eventually holds(r.ready)
}
temporal NextDerived using t over (r: Reading) clock "steps" on origin {
  eventually[1,1] holds(r.ready)
}
temporal NamedClock using t over (r: Reading) clock "ms" on origin {
  eventually[0,2] holds(r.ready)
}

language "ix:native" edition "1-draft";
profile e = "filament.temporal.event-position.false-extension/v1";
record Pulse { ok: Boolean; }
temporal Count using e over (p: Pulse) clock "events" on origin {
  always[0,2] (count where holds(p.ok) over past[0,2] min_count 0 >= 1)
}
temporal NeedsHistory using e over (p: Pulse) clock "events" on origin {
  always[0,0] (count where holds(p.ok) over past[0,2] min_count 2 >= 1)
}

language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
profile t = "filament.temporal.timestamped-event.finite-window/v1";
profile p = "filament.protocol.finite-global/v1";
object Job { ready: Boolean; population jobs; }
object Planner { alive: Boolean; population planners; }
object Machine { busy: Boolean; population machines; }
record Note { ok: Boolean; }
protocol Exchange using p over (job: Job) on origin {
  role Sender on Planner;
  role Receiver on Machine;
  channel Queue from Sender to Receiver carries Note
    ordering unordered delivery exactly-once-premise capacity 1 overflow block;
  run sequence Main {
    send Sent via Queue as (sent: Note) { true };
    await Wait after Sent using t clock "timer" within [0, 2] match receive Seen via Queue of Sent as (got: Note) { true }; then sequence InTime {} timeout sequence Late {}
  }
  finish Done as (done: Boolean) { true };
}

language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
profile p = "filament.protocol.finite-global/v1";
model Factory = "example/parts";
record Note { ok: Boolean; }
protocol Exchange using p over (job: Factory::Job) on origin {
  role Sender on Factory::PlanningService;
  role Receiver on Factory::MachiningStation;
  channel Queue from Sender to Receiver carries Note
    ordering unordered delivery exactly-once-premise capacity 1 overflow block;
  run sequence Main {
    send Sent via Queue as (sent: Note) { true };
    receive Seen via Queue of Sent as (got: Note) { true };
repeat Again by Receiver visible (got.ok) max 2 while { got.ok } sequence Cycle { commit Tick by Receiver as (tick: Boolean) { true }; } exhausted sequence Exhausted {}
  }
  finish Done as (done: Boolean) { true };
}

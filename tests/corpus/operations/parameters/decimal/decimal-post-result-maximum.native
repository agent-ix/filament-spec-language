language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
model M = "agent-ix/checked-handoff";
dimension Money;
unit U : Money = rational(1,1);
pre Before using v on M::Workflow::decimalProbe { delta >= 0.00 }
post After using v on M::Workflow::decimalProbe { result = 1.00 }

language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
model M = "agent-ix/checked-handoff";
dimension Money;
unit U : Money = rational(1,1);
pre Before using v on M::Workflow::apply { amount <= 10 U }
post After using v on M::Workflow::apply { result and amount <= 10 U }

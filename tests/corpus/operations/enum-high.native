language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
model Config = "example/config-version";
enum Level { Low,High }
function level using v(n: Config::VersionNumber): Level pure { if n<=1 then Level::Low else Level::High }
invariant High using v on Config::ConfigVersion at current { level(self.versionNumber)=Level::High }

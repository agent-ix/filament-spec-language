language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
model Config = "example/config-version";
function one using v(r: Config::ConfigVersion): Sequence<Config::ConfigVersion>[1,1] pure { sequence[r] }
invariant NotSelfParent using v on Config::ConfigVersion at current { present(self.parent) implies not contains(one(value(self.parent)),self) }

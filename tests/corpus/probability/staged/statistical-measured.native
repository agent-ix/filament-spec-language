language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
profile ev = "filament.temporal.event-position.false-extension/v1";
profile inf = "filament.temporal.infinite-trace/v1";
model Network = "test/link";
pre PendingA using v on Network::Msg::send_a { not self.delivered and self.attempts < 2 }
post OutcomeA using v on Network::Msg::send_a { self.delivered = (not lost) and self.attempts - pre(self.attempts) = 1 }
pre PendingB using v on Network::Msg::send_b { not self.delivered and self.attempts < 2 }
post OutcomeB using v on Network::Msg::send_b { self.delivered = (not lost) and self.attempts - pre(self.attempts) = 1 }
terminal Finished using v on Network when { self.delivered or self.attempts = 2 };
random Network::Msg::send_a(lost) ~ { true: 1, false: 3 };
random Network::Msg::send_b(lost) ~ { true: 1, false: 3 };
workload Traffic on Network { weight Network::Msg::send_a = 1; weight Network::Msg::send_b = 1; }
reward effort on Network::Msg::send_a = 1;
reward effort on Network::Msg::send_b = 1;
probabilistic Available using ev on Network over (packet: Network::Msg) under Traffic on origin with alpha 0.05, beta 0.05, indifference 0.05 {
 probability >= 0.8 [ eventually[0,2] holds(packet.delivered) ]
}

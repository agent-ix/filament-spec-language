language "ix:native" edition "1-draft";
profile v = "filament.model.complete/v1";
profile ev = "filament.temporal.event-position.false-extension/v1";
profile inf = "filament.temporal.infinite-trace/v1";
model Systems = "example/architecture";
random Systems::Service::call(ok) ~ { true: 3, false: 1 };
workload Traffic on Systems { weight Systems::Service::call = 1; }
probabilistic Available using ev on Systems over (service: Systems::Service) under Traffic on origin {
  quantile 0.75 of (steps from holds(service.up) until holds(not service.up) within 4) <= 3
}

+// SPDX-License-Identifier: AGPL-3.0-or-later
+//! NFR-141 package emit and package read workloads over timed-model fixtures.
+
+use criterion::{criterion_group, criterion_main, BatchSize, BenchmarkId, Criterion, Throughput};
+use fsl_bench::{package, widen};
+use fsl_package::{
+    emit_package, read_evaluation_emission, EmitLimits, SourceWitnessSupplier, V2ReadLimits,
+};
+use fsl_semantics::library::LibraryName;
+use std::hint::black_box;
+use std::time::Duration;
+
+fn selected_exact_id(axis: &str, count: usize) -> bool {
+    let arguments = std::env::args().skip(1).collect::<Vec<_>>();
+    let Some(filter) = arguments.iter().find(|argument| !argument.starts_with('-')) else {
+        return true;
+    };
+    !arguments.iter().any(|argument| argument == "--exact") || filter == &format!("{axis}/{count}")
+}
+
+fn package_axes(criterion: &mut Criterion) {
+    for count in package::MODEL_COUNTS {
+        let emit_selected = selected_exact_id("package/emit", count);
+        let read_selected = selected_exact_id("package/read", count);
+        if emit_selected || read_selected {
+            let fixture = package::fixture(count).expect("timed package fixture compiles");
+            if emit_selected {
+                let mut emit_group = criterion.benchmark_group("package/emit");
+                emit_group.sample_size(10);
+                emit_group.measurement_time(Duration::from_secs(4));
+                emit_group.throughput(Throughput::Elements(widen(count)));
+                emit_group.bench_function(BenchmarkId::from_parameter(count), |b| {
+                    b.iter(|| {
+                        black_box(emit_package(
+                            fixture.checked.package(),
+                            |_| Some(fixture.region.clone()),
+                            EmitLimits::new(1 << 32),
+                        ))
+                    });
+                });
+                emit_group.finish();
+            }
+            if read_selected {
+                let identity = LibraryName::new("package").expect("benchmark library identity");
+                let read_limits = V2ReadLimits::bounded(1 << 24);
+                let mut read_group = criterion.benchmark_group("package/read");
+                read_group.sample_size(10);
+                read_group.measurement_time(Duration::from_secs(4));
+                read_group.throughput(Throughput::Elements(widen(count)));
+                read_group.bench_function(BenchmarkId::from_parameter(count), |b| {
+                    b.iter(|| {
+                        let result = read_evaluation_emission(
+                            fixture.checked.package(),
+                            &fixture.emission,
+                            identity.clone(),
+                            &fixture.packages,
+                            read_limits,
+                            EmitLimits::new(1 << 32),
+                            SourceWitnessSupplier::new(&fixture.emission),
+                        );
+                        assert!(result.is_ok(), "checked package read succeeds");
+                        black_box(result)
+                    });
+                });
+                read_group.finish();
+            }
+        }
+    }
+    for count in package::MODEL_COUNTS {
+        if !selected_exact_id("replay/request", count) {
+            continue;
+        }
+        let fixture = package::fixture(count).expect("timed replay fixture compiles");
+        let source = package::source(count);
+        let request = package::replay_request(&fixture, &source).expect("replay request builds");
+        let limits = fsl_replay::ReplayLimits::default().with_input_bytes(1 << 30);
+        let mut replay_group = criterion.benchmark_group("replay/request");
+        replay_group.sample_size(10);
+        replay_group.measurement_time(Duration::from_secs(4));
+        replay_group.throughput(Throughput::Elements(widen(count)));
+        let result = fsl_replay::replay(request.clone(), limits);
+        assert!(result.is_ok(), "replay probe request succeeds: {result:?}");
+        replay_group.bench_function(BenchmarkId::from_parameter(count), |b| {
+            b.iter_batched(
+                || request.clone(),
+                |request| black_box(fsl_replay::replay(request, limits)),
+                BatchSize::SmallInput,
+            );
+        });
+        replay_group.finish();
+    }
+}
+
+criterion_group!(benches, package_axes);
+criterion_main!(benches);
diff --git a/fsl-bench/src/bin/fsl-bench-package-report.rs b/fsl-bench/src/bin/fsl-bench-package-report.rs
new file mode 100644
index 0000000000..fd15db92d1
--- /dev/null
+++ b/fsl-bench/src/bin/fsl-bench-package-report.rs
@@ -0,0 +1,1485 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+//! Run and report the NFR-141 package A/B measurement session.
+
+use serde::{Deserialize, Serialize};
+use std::collections::BTreeMap;
+use std::error::Error;
+use std::fs;
+use std::io;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+const SIZES: [usize; 3] = [1, 10, 100];
+const AXES: [&str; 3] = ["package/emit", "package/read", "replay/request"];
+const ROUNDS: u8 = 5;
+const MARKER: &str = "package-run-start-nanos";
+
+#[ix_trace_rs::string_edge]
+fn main() -> Result<(), Box<dyn Error>> {
+    let target = std::env::var_os("CARGO_TARGET_DIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| PathBuf::from("target"));
+    run(&target, std::env::args().skip(1))
+}
+
+#[ix_trace_rs::string_edge]
+fn run(target: &Path, arguments: impl Iterator<Item = String>) -> Result<(), Box<dyn Error>> {
+    let mut arguments = arguments;
+    match arguments
+        .next()
+        .as_deref()
+        .ok_or_else(|| io::Error::other("expected start, report, run-ab, or report-ab"))?
+    {
+        "start" => {
+            fs::create_dir_all(target)?;
+            let probe_report = target.join("package-probe-report");
+            if probe_report.exists() {
+                fs::remove_dir_all(probe_report)?;
+            }
+            let nanos = std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)?
+                .as_nanos();
+            fs::write(target.join(MARKER), nanos.to_string())?;
+            Ok(())
+        }
+        "report" => report_single(target, None),
+        "report-axis" => {
+            let axis = arguments
+                .next()
+                .ok_or_else(|| io::Error::other("report-axis requires one axis name"))?;
+            report_single(target, Some(&axis))
+        }
+        "run-ab" => {
+            let a_bench_target = required_path(&mut arguments, "A Criterion target directory")?;
+            let b_bench_target = required_path(&mut arguments, "B Criterion target directory")?;
+            let a_probe_target = required_path(&mut arguments, "A probe target directory")?;
+            let b_probe_target = required_path(&mut arguments, "B probe target directory")?;
+            let a_result = required_path(&mut arguments, "A result file")?;
+            let b_result = required_path(&mut arguments, "B result file")?;
+            run_ab(
+                &a_bench_target,
+                &b_bench_target,
+                &a_probe_target,
+                &b_probe_target,
+                &a_result,
+                &b_result,
+            )
+            .map_err(io::Error::other)?;
+            Ok(())
+        }
+        command @ ("build-bench" | "build-probe") => {
+            let target = required_path(&mut arguments, "artifact target directory")?;
+            let (cargo_args, name, kind, filename) = if command == "build-bench" {
+                (
+                    &["--release", "-p", "fsl-bench", "--bench", "package"][..],
+                    "package",
+                    "bench",
+                    "package-bench-executable",
+                )
+            } else {
+                (
+                    &[
+                        "--release",
+                        "-p",
+                        "fsl-bench",
+                        "--features",
+                        "counters",
+                        "--bin",
+                        "fsl-bench-probe",
+                    ][..],
+                    "fsl-bench-probe",
+                    "bin",
+                    "package-probe-executable",
+                )
+            };
+            let executable =
+                build_artifact(&target, cargo_args, name, kind).map_err(io::Error::other)?;
+            fs::create_dir_all(&target)?;
+            fs::write(
+                target.join(filename),
+                executable.to_string_lossy().as_bytes(),
+            )?;
+            println!("{}", executable.display());
+            Ok(())
+        }
+        "report-ab" => {
+            let a_result = required_path(&mut arguments, "A result file")?;
+            let b_result = required_path(&mut arguments, "B result file")?;
+            report_ab_files(&a_result, &b_result).map_err(io::Error::other)?;
+            Ok(())
+        }
+        command => Err(io::Error::other(format!("unknown command: {command}")).into()),
+    }
+}
+
+fn required_path(
+    arguments: &mut impl Iterator<Item = String>,
+    label: &str,
+) -> Result<PathBuf, io::Error> {
+    arguments
+        .next()
+        .map(PathBuf::from)
+        .ok_or_else(|| io::Error::other(format!("missing {label}")))
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+struct SideResults {
+    side: String,
+    rounds: Vec<RoundResult>,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+struct LoadAverage {
+    one_minute: f64,
+    five_minutes: f64,
+    fifteen_minutes: f64,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+struct RoundResult {
+    number: u8,
+    load_before: Measurement<LoadAverage>,
+    load_after: Measurement<LoadAverage>,
+    axes: BTreeMap<String, BTreeMap<usize, Measurement<CriterionEstimate>>>,
+    probes: BTreeMap<usize, Measurement<ProbeEstimate>>,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+struct Measurement<T> {
+    value: Option<T>,
+    error: Option<String>,
+    output: Option<String>,
+}
+
+impl<T> Measurement<T> {
+    fn success(value: T) -> Self {
+        Self {
+            value: Some(value),
+            error: None,
+            output: None,
+        }
+    }
+
+    fn failure(error: impl Into<String>, output: impl Into<String>) -> Self {
+        Self {
+            value: None,
+            error: Some(error.into()),
+            output: Some(output.into()),
+        }
+    }
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+struct CriterionEstimate {
+    milliseconds: f64,
+    ci_lower_milliseconds: f64,
+    ci_upper_milliseconds: f64,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+struct ProbeEstimate {
+    milliseconds: f64,
+    peak_rss_kib: u64,
+    parse_calls_per_source_document: u64,
+    source_documents: u64,
+}
+
+fn run_ab(
+    a_bench_target: &Path,
+    b_bench_target: &Path,
+    a_probe_target: &Path,
+    b_probe_target: &Path,
+    a_result_path: &Path,
+    b_result_path: &Path,
+) -> Result<(), String> {
+    if a_result_path.exists() || b_result_path.exists() {
+        return Err(
+            "refusing to overwrite existing A/B result files; start a new session with new paths"
+                .to_owned(),
+        );
+    }
+    let a_bench = recorded_artifact(a_bench_target, "package-bench-executable")?;
+    let b_bench = recorded_artifact(b_bench_target, "package-bench-executable")?;
+    let a_probe = recorded_artifact(a_probe_target, "package-probe-executable")?;
+    let b_probe = recorded_artifact(b_probe_target, "package-probe-executable")?;
+    let mut a_results = SideResults {
+        side: "A".to_owned(),
+        rounds: Vec::new(),
+    };
+    let mut b_results = SideResults {
+        side: "B".to_owned(),
+        rounds: Vec::new(),
+    };
+    let a_criterion_home = a_result_path.with_extension("criterion");
+    let b_criterion_home = b_result_path.with_extension("criterion");
+    fs::create_dir_all(&a_criterion_home)
+        .map_err(|error| format!("create A Criterion directory: {error}"))?;
+    fs::create_dir_all(&b_criterion_home)
+        .map_err(|error| format!("create B Criterion directory: {error}"))?;
+    let mut run_round = |side: &str, round: u8| match side {
+        "A" => run_side_round(
+            side,
+            round,
+            &a_bench,
+            &a_probe,
+            &a_criterion_home,
+            a_result_path,
+            &[
+                ("package/emit", "package/emit"),
+                ("package/read", "package/read"),
+                ("replay/request", "replay/request"),
+            ],
+            &SIZES,
+            true,
+        ),
+        "B" => run_side_round(
+            side,
+            round,
+            &b_bench,
+            &b_probe,
+            &b_criterion_home,
+            b_result_path,
+            &[
+                ("package/emit", "package/emit"),
+                ("package/read", "package/read"),
+                ("replay/request", "replay/request"),
+            ],
+            &SIZES,
+            true,
+        ),
+        _ => unreachable!("the scheduled sides are A and B"),
+    };
+    run_scheduled_rounds(
+        a_result_path,
+        b_result_path,
+        &mut a_results,
+        &mut b_results,
+        &mut run_round,
+    )
+}
+
+fn recorded_artifact(target: &Path, filename: &str) -> Result<PathBuf, String> {
+    let path = target.join(filename);
+    let executable = fs::read_to_string(&path)
+        .map_err(|error| format!("read recorded Cargo artifact {}: {error}", path.display()))?;
+    let executable = PathBuf::from(executable);
+    if !executable.is_file() {
+        return Err(format!(
+            "recorded Cargo artifact does not exist: {}",
+            executable.display()
+        ));
+    }
+    Ok(executable)
+}
+
+fn run_scheduled_rounds(
+    a_result_path: &Path,
+    b_result_path: &Path,
+    a_results: &mut SideResults,
+    b_results: &mut SideResults,
+    run_round: &mut impl FnMut(&str, u8) -> RoundResult,
+) -> Result<(), String> {
+    persist_results(a_result_path, a_results)?;
+    persist_results(b_result_path, b_results)?;
+    for round in 1..=ROUNDS {
+        a_results.rounds.push(run_round("A", round));
+        persist_results(a_result_path, a_results)?;
+        b_results.rounds.push(run_round("B", round));
+        persist_results(b_result_path, b_results)?;
+    }
+    report_ab(a_results, b_results)
+}
+
+fn run_side_round(
+    side: &str,
+    number: u8,
+    bench: &Path,
+    probe: &Path,
+    criterion_home: &Path,
+    result_path: &Path,
+    axis_filters: &[(&str, &str)],
+    sizes: &[usize],
+    include_replay_probes: bool,
+) -> RoundResult {
+    let load_before = load_average()
+        .map(Measurement::success)
+        .unwrap_or_else(|error| Measurement::failure(error, ""));
+    let mut axes = BTreeMap::new();
+    for &(axis, filter) in axis_filters {
+        let mut estimates = BTreeMap::new();
+        for &size in sizes {
+            let baseline = format!(
+                "package-{side}-round-{number}-{}-{size}",
+                axis.replace('/', "-")
+            );
+            let exact_filter = if filter.ends_with(&format!("/{size}")) {
+                filter.to_owned()
+            } else {
+                format!("{filter}/{size}")
+            };
+            let output = Command::new(bench)
+                .arg("--bench")
+                .arg(exact_filter)
+                .arg("--exact")
+                .arg("--save-baseline")
+                .arg(&baseline)
+                .env("CRITERION_HOME", criterion_home)
+                .output();
+            let result = match output {
+                Ok(output) if output.status.success() => {
+                    criterion_estimate(criterion_home, axis, size, &baseline)
+                        .map(Measurement::success)
+                        .unwrap_or_else(|error| {
+                            Measurement::failure(error, String::from_utf8_lossy(&output.stdout))
+                        })
+                }
+                Ok(output) => Measurement::failure(
+                    "Criterion benchmark failed",
+                    format!(
+                        "exit={} stderr={} stdout={}",
+                        output.status,
+                        String::from_utf8_lossy(&output.stderr),
+                        String::from_utf8_lossy(&output.stdout)
+                    ),
+                ),
+                Err(error) => {
+                    Measurement::failure(format!("start Criterion benchmark: {error}"), "")
+                }
+            };
+            estimates.insert(size, result);
+        }
+        axes.insert((*axis).to_owned(), estimates);
+    }
+    let mut probes = BTreeMap::new();
+    if include_replay_probes {
+        for &size in sizes {
+            let probe_report =
+                result_path.with_extension(format!("{side}-round-{number}-m-{size}.probe"));
+            let output = Command::new(probe)
+                .arg("package")
+                .arg("replay/request")
+                .arg(size.to_string())
+                .env("FSL_PACKAGE_PROBE_REPORT", &probe_report)
+                .output();
+            let measurement = match output {
+                Ok(output) if output.status.success() => {
+                    let stdout = String::from_utf8_lossy(&output.stdout);
+                    parse_probe_estimate(&stdout, size)
+                        .map(Measurement::success)
+                        .unwrap_or_else(|error| Measurement::failure(error, stdout.to_string()))
+                }
+                Ok(output) => Measurement::failure(
+                    format!("replay RSS probe exited {}", output.status),
+                    format!(
+                        "stderr={} stdout={}",
+                        String::from_utf8_lossy(&output.stderr),
+                        String::from_utf8_lossy(&output.stdout)
+                    ),
+                ),
+                Err(error) => Measurement::failure(format!("start replay RSS probe: {error}"), ""),
+            };
+            probes.insert(size, measurement);
+        }
+    }
+    let load_after = load_average()
+        .map(Measurement::success)
+        .unwrap_or_else(|error| Measurement::failure(error, ""));
+    RoundResult {
+        number,
+        load_before,
+        load_after,
+        axes,
+        probes,
+    }
+}
+
+fn build_artifact(
+    target: &Path,
+    cargo_args: &[&str],
+    expected_name: &str,
+    expected_kind: &str,
+) -> Result<PathBuf, String> {
+    let workspace_root = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .ok_or_else(|| "fsl-bench manifest has no workspace parent".to_owned())?
+        .to_path_buf();
+    let output = Command::new("cargo")
+        .args([
+            "build",
+            "--locked",
+            "-j",
+            "4",
+            "--message-format=json-render-diagnostics",
+        ])
+        .args(cargo_args)
+        .current_dir(&workspace_root)
+        .env("CARGO_TARGET_DIR", target)
+        .output()
+        .map_err(|error| format!("start Cargo artifact build for {expected_name}: {error}"))?;
+    if !output.status.success() {
+        return Err(format!(
+            "Cargo artifact build for {expected_name} failed: stdout={} stderr={}",
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr)
+        ));
+    }
+    let mut artifact = None;
+    for line in String::from_utf8_lossy(&output.stdout).lines() {
+        let Ok(message) = serde_json::from_str::<serde_json::Value>(line) else {
+            continue;
+        };
+        if message["reason"] == "compiler-artifact"
+            && message["target"]["name"] == expected_name
+            && message["target"]["kind"]
+                .as_array()
+                .is_some_and(|kinds| kinds.iter().any(|kind| kind == expected_kind))
+        {
+            if let Some(executable) = message["executable"].as_str() {
+                artifact = Some(PathBuf::from(executable));
+            }
+        }
+    }
+    artifact.ok_or_else(|| {
+        format!("Cargo JSON output contained no {expected_kind} artifact named {expected_name}")
+    })
+}
+
+fn criterion_estimate(
+    root: &Path,
+    axis: &str,
+    size: usize,
+    baseline: &str,
+) -> Result<CriterionEstimate, String> {
+    let path = root
+        .join(axis.replace('/', "_"))
+        .join(size.to_string())
+        .join(baseline)
+        .join("estimates.json");
+    let bytes = fs::read(&path).map_err(|error| format!("read {}: {error}", path.display()))?;
+    let value: serde_json::Value = serde_json::from_slice(&bytes)
+        .map_err(|error| format!("decode {}: {error}", path.display()))?;
+    let mean = &value["mean"];
+    let nanos = mean["point_estimate"]
+        .as_f64()
+        .ok_or_else(|| format!("{} has no mean point estimate", path.display()))?;
+    let lower = mean["confidence_interval"]["lower_bound"]
+        .as_f64()
+        .ok_or_else(|| format!("{} has no mean CI lower bound", path.display()))?;
+    let upper = mean["confidence_interval"]["upper_bound"]
+        .as_f64()
+        .ok_or_else(|| format!("{} has no mean CI upper bound", path.display()))?;
+    Ok(CriterionEstimate {
+        milliseconds: nanos / 1_000_000.0,
+        ci_lower_milliseconds: lower / 1_000_000.0,
+        ci_upper_milliseconds: upper / 1_000_000.0,
+    })
+}
+
+fn parse_probe_estimate(output: &str, size: usize) -> Result<ProbeEstimate, String> {
+    let row = output
+        .lines()
+        .find(|line| line.starts_with("axis=replay/request "))
+        .ok_or_else(|| "probe output has no replay/request row".to_owned())?;
+    let mut fields = BTreeMap::new();
+    for part in row.split_whitespace() {
+        if let Some((name, value)) = part.split_once('=') {
+            fields.insert(name, value);
+        }
+    }
+    let number = |name: &str| {
+        fields
+            .get(name)
+            .ok_or_else(|| format!("probe report is missing {name}"))?
+            .parse::<f64>()
+            .map_err(|error| format!("probe report {name} is invalid: {error}"))
+    };
+    let exact = |name: &str, expected: &str| fields.get(name).copied() == Some(expected);
+    let probe_size = fields
+        .get("M")
+        .ok_or_else(|| "probe report is missing M".to_owned())?
+        .parse::<usize>()
+        .map_err(|error| format!("probe report M is invalid: {error}"))?;
+    if probe_size != size || !exact("source_documents", "1") || !exact("succeeded", "true") {
+        return Err(format!(
+            "probe report has wrong size or unsuccessful result: {row}"
+        ));
+    }
+    let peak_rss_kib = fields
+        .get("peak_rss_kib")
+        .ok_or_else(|| "probe report is missing peak_rss_kib".to_owned())?
+        .parse::<u64>()
+        .map_err(|error| format!("probe report peak_rss_kib is invalid: {error}"))?;
+    let parse_calls_per_source_document = fields
+        .get("parse_calls_per_source_document")
+        .ok_or_else(|| "probe report is missing parse_calls_per_source_document".to_owned())?
+        .parse::<u64>()
+        .map_err(|error| format!("probe report parse-call count is invalid: {error}"))?;
+    if peak_rss_kib == 0 || parse_calls_per_source_document == 0 {
+        return Err(format!(
+            "probe report contains a zero RSS or parse-call value: {row}"
+        ));
+    }
+    Ok(ProbeEstimate {
+        milliseconds: number("wall_ms")?,
+        peak_rss_kib,
+        parse_calls_per_source_document,
+        source_documents: 1,
+    })
+}
+
+fn load_average() -> Result<LoadAverage, String> {
+    let output = Command::new("uptime")
+        .output()
+        .map_err(|error| format!("read uptime: {error}"))?;
+    if !output.status.success() {
+        return Err(format!("uptime exited {}", output.status));
+    }
+    let text = String::from_utf8_lossy(&output.stdout);
+    let values = text
+        .split_once("load averages:")
+        .or_else(|| text.split_once("load average:"))
+        .map(|(_, tail)| tail)
+        .ok_or_else(|| format!("uptime has no load average: {text}"))?
+        .split(|ch: char| ch == ',' || ch.is_whitespace())
+        .filter_map(|part| part.parse::<f64>().ok())
+        .take(3)
+        .collect::<Vec<_>>();
+    let [one_minute, five_minutes, fifteen_minutes] = values.as_slice() else {
+        return Err(format!("uptime has fewer than three load averages: {text}"));
+    };
+    Ok(LoadAverage {
+        one_minute: *one_minute,
+        five_minutes: *five_minutes,
+        fifteen_minutes: *fifteen_minutes,
+    })
+}

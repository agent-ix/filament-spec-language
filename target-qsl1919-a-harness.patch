+                assert_eq!(model.operations.len(), 1, "one operation");
+                assert_eq!(model.operations[0].name, "step");
+            }
+            let unit = source(count);
+            assert_eq!(unit.matches("time M").count(), count);
+            assert_eq!(unit.matches("pre Ready").count(), count);
